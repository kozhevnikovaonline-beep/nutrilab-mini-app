# ───────── Фронтенд (Mini App), подставляются при сборке ─────────
# Адрес бэкенда. Пусто → демо-режим: данные хранятся на устройстве пользователя.
VITE_API_URL=
# Username бота без @ (для реферальных ссылок)
VITE_BOT_USERNAME=Nutribot_testbot
# Short name Mini App из BotFather (/newapp) — ссылка вида t.me/<bot>/<short_name>
VITE_APP_SHORT_NAME=app
# Куда ведут кнопки «Записаться на консультацию» / «Поддержка»
VITE_MANAGER_USERNAME=oksanakozh_tech
# Канал школы (задание «Подписаться на канал»)
VITE_CHANNEL_USERNAME=kozhevnikova_blog

# ───────── Сервер и бот (папка server/) — НИКОГДА не коммитьте реальные значения ─────────
# Токен из @BotFather → /mybots → Nutribot_testbot → API Token
BOT_TOKEN=
WEBAPP_URL=https://kozhevnikovaonline-beep.github.io/nutrilab-mini-app/
PORT=8080
DATA_FILE=./data/db.json
# Проверка подписки: @kozhevnikova_blog — только после того, как бот станет администратором канала
CHANNEL_ID=
MANAGER_USERNAME=oksanakozh_tech
# Оплата курсов рублями: @BotFather → /mybots → бот → Payments → провайдер (например, ЮKassa).
# Пусто → кнопка «Купить за ₽» отправляет заявку менеджеру.
PAYMENT_PROVIDER_TOKEN=
