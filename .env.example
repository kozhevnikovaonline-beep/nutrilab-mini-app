# ───────── Фронтенд (Mini App), подставляются при сборке ─────────
# Адрес бэкенда. Пусто → демо-режим: данные хранятся на устройстве пользователя.
VITE_API_URL=
# Username бота без @ (для реферальных ссылок)
VITE_BOT_USERNAME=nutrilab_demo_bot
# Short name Mini App из BotFather (/newapp) — ссылка вида t.me/<bot>/<short_name>
VITE_APP_SHORT_NAME=app
# Куда ведут кнопки «Записаться на консультацию» / «Поддержка»
VITE_MANAGER_USERNAME=nutrilab_manager
# Канал школы (задание «Подписаться на канал»)
VITE_CHANNEL_USERNAME=nutrilab_school

# ───────── Сервер (папка server/) — НИКОГДА не коммитьте реальные значения ─────────
BOT_TOKEN=
WEBAPP_URL=https://<github-username>.github.io/<repo>/
PORT=8080
DATA_FILE=./data/db.json
# @username канала или его id; бот должен быть администратором канала
CHANNEL_ID=
MANAGER_USERNAME=nutrilab_manager
